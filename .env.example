# Solana RPC — use Helius for best results (full holder lists, fast)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Helius API Key — https://helius.dev (free tier available)
# Required for: full holder lists (1000+), enriched swap transactions
HELIUS_API_KEY=

# Birdeye API Key — https://birdeye.so (free tier available)
# Required for: wallet ROI, WinRate, PnL data
BIRDEYE_API_KEY=

# How many holders to scan per token (default 500)
MAX_HOLDERS_TO_PARSE=500

# Output directory for CSV/TXT results
RESULTS_DIR=results

# ── Filters (Froggy v2 recommendations) ───────────────────────────────────

# Minimum ROI, % (recommended: 50)
FILTER_MIN_ROI=50

# Minimum Win Rate, % (recommended: 50; minimum acceptable: 30)
FILTER_MIN_WINRATE=50

# Maximum Fast Trades, % — trades closed in < 3 minutes
# Above 15% signals rug-pull / bot behaviour
FILTER_MAX_FAST_TRADES_PCT=15

# Maximum SMTB (Sold More Than Buy), %
# ~1 per 10 trades is OK, but > 10% is a red flag
FILTER_MAX_SMTB_PCT=10

# Minimum SOL balance
FILTER_MIN_BALANCE_SOL=2

# Minimum number of different tokens traded (< 3 = fresh account, skip)
FILTER_MIN_TOKENS_TOTAL=3

# Minimum trades per week
FILTER_MIN_TRADES_PER_WEEK=1

# Absolute minimum total trades
FILTER_MIN_TOTAL_TRADES=5
