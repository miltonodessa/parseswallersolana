# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Solana RPC (use Helius for best results)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Helius API (optional, for enhanced transaction history)
HELIUS_API_KEY=your_helius_api_key_here

# Birdeye API (optional, for wallet PnL data)
BIRDEYE_API_KEY=your_birdeye_api_key_here

# Parser settings
MAX_HOLDERS_TO_PARSE=500
MIN_ROI_FILTER=50
MIN_WINRATE_FILTER=50
MIN_TRADES_FILTER=5
RESULTS_DIR=results
